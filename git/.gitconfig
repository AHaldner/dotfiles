[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[user]
    name = YOUR NAME HERE
    email = YOUR EMAIL HERE

[http]
    postBuffer = 157286400

[init]
    defaultBranch = main

[core]
    autocrlf = input
    editor = "nano --wait"

[credential]
    helper = osxkeychain

[push]
    default = current

[color]
    ui = auto

[alias]
    # frequent essentials
    s  = status -sb
    a  = add .
    aa = add -A
    rt = reset --hard

    # pretty git log
    lg = log --graph --decorate --all --pretty=format:'%C(auto)%h %C(bold blue)%an%Creset %C(dim)%cr%Creset %C(yellow)%d%Creset%n  %s'

	# add + commit + push
    acp = "!git add . && git commit -m \"$*\" && git push"